model Area {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String
  status      AreaStatus   @default(ACTIVE)

  feederId    String
  feeder      Feeder       @relation(fields: [feederId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([feederId])
  @@index([status])
  @@index([deletedAt])
  @@map("areas")
}
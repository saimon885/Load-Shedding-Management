model User {
    id        String     @id @default(uuid())
    name      String?
    email     String     @unique
    password  String
    role      UserRole   @default(CUSTOMER)
    phone     String?
    profile   Profile?
    status    userStatus @default(ACTIVE)
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    deletedAt DateTime?

    @@map("users")
}

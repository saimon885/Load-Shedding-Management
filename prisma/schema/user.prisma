model User {
    id        Int       @id @default(autoincrement())
    name      String?
    email     String    @unique
    password  String
    role      UserRole @default(CUSTOMER)
    phone     String?
    profile   Profile?
    status    String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@map("users")
}

model Feeder {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  capacity    Int?
  status      FeederStatus  @default(ACTIVE)

  substationId String
  substation   Substation   @relation(fields: [substationId], references: [id])

  areas        Area[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([substationId])
  @@index([status])
  @@index([deletedAt])
  @@map("feeders")
}